// npm install @angular/core @tanstack/store chart.js

// main.ts (entry point for standalone Angular app)
import { bootstrapApplication } from '@angular/platform-browser';
import { AppComponent } from './app.component';

bootstrapApplication(AppComponent);

// store.ts
import { createStore } from '@tanstack/store';

export const store = createStore(() => ({
  profit: 10000,
  loss: 5000,
}));

export function updateProfit(value: number) {
  store.setState((state) => ({ ...state, profit: state.profit + value }));
}

export function updateLoss(value: number) {
  store.setState((state) => ({ ...state, loss: state.loss + value }));
}

// sidebar.component.ts
import { Component } from '@angular/core';

@Component({
  selector: 'app-sidebar',
  standalone: true,
  template: `
    <nav>
      <ul>
        <li><a href="#">Dashboard</a></li>
      </ul>
    </nav>
  `,
  styles: ['nav { width: 200px; background: #ddd; height: 100vh; padding: 1rem; }']
})
export class SidebarComponent {}

// dashboard.component.ts
import { Component } from '@angular/core';
import { store } from './store';

@Component({
  selector: 'app-dashboard',
  standalone: true,
  template: `
    <h1>Dashboard</h1>
    <p>Profit: {{ store.state.profit }}</p>
    <p>Loss: {{ store.state.loss }}</p>
    <button (click)="updateProfit(1000)">Increase Profit</button>
    <button (click)="updateLoss(500)">Increase Loss</button>
    <canvas id="barChart"></canvas>
  `,
})
export class DashboardComponent {
  store = store;
  updateProfit(value: number) { store.setState((s) => ({ ...s, profit: s.profit + value })); }
  updateLoss(value: number) { store.setState((s) => ({ ...s, loss: s.loss + value })); }
}

// app.component.ts
import { Component } from '@angular/core';
import { SidebarComponent } from './sidebar.component';
import { DashboardComponent } from './dashboard.component';

@Component({
  selector: 'app-root',
  standalone: true,
  imports: [SidebarComponent, DashboardComponent],
  template: `
    <div style="display: flex">
      <app-sidebar></app-sidebar>
      <app-dashboard></app-dashboard>
    </div>
  `,
})
export class AppComponent {}
